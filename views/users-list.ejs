<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Users | EcoSync</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site-header">
    <div class="site-header__inner">
      <a class="brand" href="/admin-panel" aria-label="EcoSync administration">
        <span class="brand__mark" aria-hidden="true">E</span>
        <span class="brand__text">
          <span class="brand__name">EcoSync</span>
          <span class="brand__descriptor">Administration</span>
        </span>
      </a>
      <a class="btn btn--quiet" href="/admin-panel">Back to admin</a>
    </div>
  </header>

  <main class="page" id="main-content">
    <div class="page-heading page-heading--split">
      <div>
        <p class="eyebrow">Access control</p>
        <h1>User directory</h1>
        <p class="lede">Review assigned roles and maintain user access.</p>
      </div>
      <a class="btn btn--secondary" href="/admin-panel">Create a user</a>
    </div>

    <section class="surface" aria-labelledby="user-list-title">
      <div class="surface__header">
        <h2 id="user-list-title">All users</h2>
      </div>
      <div class="surface__body">
        <% if (users.length === 0) { %>
          <div class="empty-state">No users have been added yet.</div>
        <% } else { %>
          <ul class="list">
            <% users.forEach(user => { %>
              <li class="list-row">
                <div>
                  <div class="list-row__primary"><%= user.username %></div>
                  <div class="list-row__secondary">Role: <%= user.role %></div>
                </div>
                <div class="actions">
                  <a class="btn btn--secondary" href="/users/edit/<%= user._id %>">Edit</a>
                  <form class="inline-form" action="/users/delete/<%= user._id %>" method="POST">
                    <button class="btn btn--danger" type="submit">Delete</button>
                  </form>
                </div>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </section>
  </main>
</body>
</html>
