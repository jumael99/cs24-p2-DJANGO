<!DOCTYPE html>
<html>
<head>
    <title>Users List</title>
    <link href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .container {
            margin-top: 50px;
        }
        .user-row {
            margin-bottom: 10px;
        }
        .user-card {
            background-color: #f9f9f9;
            border: 1px solid #ddd;
            padding: 15px;
            border-radius: 5px;
        }
        .user-action button {
            background-color: #f44336; /* Red */
            color: white;
            margin-right: 5px;
        }
        .edit-profile {
            margin-top: 20px;
        }
    </style>
</head>
<body>

<div class="container">
    <h2 class="mb-4 text-center">Users List</h2>
    <% users.forEach(user => { %>
        <div class="row user-row">
            <div class="col-md-12">
                <div class="user-card d-flex justify-content-between align-items-center">
                    <div>
                        <strong><%= user.username %></strong> - <span><%= user.role %></span>
                    </div>
                    <div class="user-action">
                        <a href="/users/edit/<%= user._id %>" class="btn btn-primary btn-sm">Edit</a>
                        <!-- Delete Form -->
                        <form action="/users/delete/<%= user._id %>" method="POST" style="display: inline;">
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    <% }) %>
    <div class="edit-profile text-center">
        <a href="/admin-panel" class="btn btn-info">Go to admin panel</a>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.3/dist/umd/popper.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
