<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Entries</title>
  <!-- Bootstrap CSS for styling -->
  <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    /* Additional styles */
    .distance-display {
      margin-top: 10px;
    }
  </style>
</head>
<body>
<div class="w-50 mx-auto shadow p-5 my-5">
  <h2>Data Entries</h2>
  <form action="/sts-data/create" method="post">
    <div class="form-group">
      <label for="stsNumber">STS Number:</label>
      <input type="number" class="form-control" id="stsNumber" name="stsNumber" required />
    </div>
    <div class="form-group">
      <label for="wasteWeight">Wastage Amount (tons):</label>
      <input type="number" class="form-control" id="wasteWeight" name="wasteWeight" required />
    </div>
    <div class="form-group">
      <label for="startTime">Starting Time:</label>
      <input type="time" class="form-control" id="startTime" name="startTime" required />
    </div>
    <!-- Dropdown for landfill selection -->
    <div class="form-group">
      <label for="landfillSelection">Select Landfill (Select Distance for STS Efficiency):</label>
      <select class="form-control" id="landfillSelection" name="landfillSelection" onchange="showDistance()">
        <option value="">Select Landfill</option>
        <option value="Amibazar">Amibazar Landfill</option>
        <option value="Matuail">Matuail Landfill</option>
      </select>
    </div>
    <!-- Display for distance -->
    <div class="form-group distance-display" id="distanceDisplay" style="display: none;">
      <label for="distanceKm">Distance (Km):</label>
      <input type="text" class="form-control" id="distanceKm" name="distanceKm" readonly />
    </div>
    <button type="submit" class="btn btn-primary mt-2">Submit</button>
  </form>
  <!-- Updated Go back link to match the size of the submit button -->
  <a href="/sts-manager-panel" class="btn btn-primary back-button mt-3">Go back</a>
</div>

<script>
  // Generate initial random distances for both landfills when the page loads
  let amibazarDistance = getRandomDistance(15, 23);
  let matuailDistance = getRandomDistance(15, 23);

  function showDistance() {
    const selection = document.getElementById('landfillSelection').value;
    const distanceDisplay = document.getElementById('distanceDisplay');
    const distanceKm = document.getElementById('distanceKm');

    if (selection === 'Amibazar') {
      distanceDisplay.style.display = 'block';
      distanceKm.value = amibazarDistance; // Use the pre-generated distance for Amibazar
    } else if (selection === 'Matuail') {
      distanceDisplay.style.display = 'block';
      distanceKm.value = matuailDistance; // Use the pre-generated distance for Matuail
    } else {
      distanceDisplay.style.display = 'none';
      distanceKm.value = ''; // Clear the value if no landfill is selected
    }
  }

  function getRandomDistance(min, max) {
    // Generate a random number between min and max, inclusive
    return Math.floor(Math.random() * (max - min + 1)) + min;
  }

  // Optional: Reset distances when the form is submitted
  document.querySelector('form').addEventListener('submit', function() {
    amibazarDistance = getRandomDistance(15, 23);
    matuailDistance = getRandomDistance(15, 23);
  });
</script>

</body>
</html>
