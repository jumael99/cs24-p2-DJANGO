<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Generate STS Report | EcoSync</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site-header">
    <div class="site-header__inner">
      <a class="brand" href="/landfill-manager-panel" aria-label="EcoSync landfill workspace">
        <span class="brand__mark" aria-hidden="true">E</span>
        <span class="brand__text">
          <span class="brand__name">EcoSync</span>
          <span class="brand__descriptor">Landfill workspace</span>
        </span>
      </a>
      <a class="btn btn--quiet" href="/landfill-manager-panel">Back to workspace</a>
    </div>
  </header>

  <main class="page page--narrow" id="main-content">
    <div class="page-heading">
      <p class="eyebrow">Reporting</p>
      <h1>Generate an STS report</h1>
      <p class="lede">Enter the transfer station number to retrieve its latest transport data.</p>
    </div>

    <section class="surface" aria-labelledby="report-form-title">
      <div class="surface__header">
        <h2 id="report-form-title">Report lookup</h2>
      </div>
      <form action="/print-report" method="post">
        <div class="surface__body">
          <div class="field">
            <label for="stsNumber">STS number</label>
            <input class="input" type="text" id="stsNumber" name="stsNumber" inputmode="numeric" value="<%= isDemo ? '101' : '' %>" required autofocus />
            <p class="field__hint"><%= isDemo ? 'Use sample STS 101 to download a demonstration report.' : 'A PDF transport report will be generated from the matching record.' %></p>
          </div>
        </div>
        <div class="surface__footer actions">
          <button class="btn btn--primary" type="submit">Download PDF report</button>
          <a class="btn btn--secondary" href="/landfill-manager-panel">Cancel</a>
        </div>
      </form>
    </section>
  </main>
</body>
</html>
