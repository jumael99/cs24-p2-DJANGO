<h2>Route Optimization</h2>
<ul class="list-group">
    <% routes.forEach(function(route) { %>
        <li class="list-group-item">
            <h5><%= route.routeName %></h5>
            Estimated Time: <%= route.estimatedTime %><br>
            Fuel Consumption: <%= route.fuelConsumption %><br>
            Traffic Condition: <%= route.trafficCondition %>
        </li>
    <% }) %>
</ul>
