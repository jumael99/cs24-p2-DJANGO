<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Profile | EcoSync</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site-header">
    <div class="site-header__inner">
      <a class="brand" href="<%= role === 'admin' ? '/admin-panel' : role === 'stsManager' ? '/sts-manager-panel' : '/landfill-manager-panel' %>" aria-label="EcoSync workspace">
        <span class="brand__mark" aria-hidden="true">E</span>
        <span class="brand__text">
          <span class="brand__name">EcoSync</span>
          <span class="brand__descriptor">My account</span>
        </span>
      </a>
      <a class="btn btn--quiet" href="<%= role === 'admin' ? '/admin-panel' : role === 'stsManager' ? '/sts-manager-panel' : '/landfill-manager-panel' %>">Back to workspace</a>
    </div>
  </header>

  <main class="page page--narrow" id="main-content">
    <div class="page-heading">
      <p class="eyebrow">My account</p>
      <h1>Profile settings</h1>
      <p class="lede">Keep your personal and sign-in information current.</p>
    </div>

    <% if (isDemo) { %>
      <div class="demo-notice" role="status"><strong>Client preview</strong><span>This sample profile is read-only and does not represent a live account.</span><a href="/#workspaces">Switch role</a></div>
    <% } %>

    <div class="section-stack">
      <section class="profile-summary" aria-label="Current account summary">
        <div>
          <p class="profile-summary__name"><%= user.name %></p>
          <p class="muted">@<%= user.username %></p>
        </div>
        <span class="badge">
          <% if (user.role === 'stsManager') { %>
            STS Manager
          <% } else if (user.role === 'admin') { %>
            Admin
          <% } else if (user.role === 'landfillManager') { %>
            Landfill Manager
          <% } else { %>
            <%= user.role %>
          <% } %>
        </span>
      </section>

      <section class="surface" aria-labelledby="profile-form-title">
        <div class="surface__header">
          <h2 id="profile-form-title">Account details</h2>
        </div>
        <form action="/profile" method="post">
          <div class="surface__body">
            <div class="form-grid form-grid--two">
              <div class="field">
                <label for="name">Full name</label>
                <input class="input" type="text" id="name" name="name" autocomplete="name" value="<%= user.name %>" required />
              </div>
              <div class="field">
                <label for="email">Email</label>
                <input class="input" type="email" id="email" name="email" autocomplete="email" value="<%= user.email %>" required />
              </div>
              <div class="field">
                <label for="username">Username</label>
                <input class="input" type="text" id="username" name="username" autocomplete="username" value="<%= user.username %>" required />
              </div>
              <div class="field">
                <label for="gender">Gender</label>
                <select class="select" id="gender" name="gender" required>
                  <option value="Male" <%= user.gender === 'Male' ? 'selected' : '' %>>Male</option>
                  <option value="Female" <%= user.gender === 'Female' ? 'selected' : '' %>>Female</option>
                  <option value="Other" <%= user.gender === 'Other' ? 'selected' : '' %>>Other</option>
                </select>
              </div>
              <div class="field field--wide">
                <label for="password">New password</label>
                <input class="input" type="password" id="password" name="password" autocomplete="new-password" placeholder="Leave blank to keep current password" />
              </div>
            </div>
          </div>
          <div class="surface__footer actions">
            <% if (!isDemo) { %>
              <button class="btn btn--primary" type="submit">Save changes</button>
            <% } %>
            <a class="btn btn--secondary" href="<%= role === 'admin' ? '/admin-panel' : role === 'stsManager' ? '/sts-manager-panel' : '/landfill-manager-panel' %>">Cancel</a>
          </div>
        </form>
      </section>
    </div>
  </main>
</body>
</html>
