<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User Profile</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <style>
        .username-display {
            font-size: 2.5rem;
            font-weight: bold;
            color: #007bff;
            margin-bottom: 1rem;
        }
        .mycarddetails {
            width: 50%;
        }
     .box-childs > * {
      width: 45%;
    }
     </style>
</head>
<body class="bg-light position-relative">
<!-- <div class="border-5 text-center shadow-lg p-2 mb-4">
    Current User: <%= user.username %>
</div> -->
<div class="container py-5 mycarddetails my-5 shadow">
    <div class="text-center mb-4 card-title">
        <div class="username-display">User Profile</div>
    </div>
    <div class="row justify-content-center p-4">
        <div class="col-md-12">
            <form action="/profile" method="post">
                <div class="form-group d-flex align-items-center  justify-content-around   ">
                    <!-- <label for="userRole">Role:</label> -->
                    <p class="text-center  fw-bold  ">
                        User Name: <%= user.username %>
                    </p>
                    <p type="" class="fw-bold " disabled id="userRole">
                        Role: 
                        <% if (user.role === 'stsManager') { %>
                            STS Manager
                        <% } else if (user.role === 'admin') { %>
                            Admin
                        <% } else if (user.role === 'landfillManager') { %>
                            Landfill Manager
                        <% } else { %>
                            <%= user.role %> <!-- Fallback to displaying the raw role value -->
                        <% } %>
                    </p>
                </div>
               <div class="d-flex justify-content-between box-childs">
                <div class="form-group  ">
                    <label for="name">Name:</label>
                    <input type="text" class="form-control" id="name" name="name" value="<%= user.name %>" required />
                </div>
                <div class="form-group">
                    <label for="email">Email:</label>
                    <input type="email" class="form-control" id="email" name="email" value="<%= user.email %>" required />
                </div>
               </div>
               <div class="d-flex justify-content-between box-childs">
                <div class="form-group">
                    <label for="username">Username:</label>
                    <input type="text" class="form-control" id="username" name="username" value="<%= user.username %>" required />
                </div>
                <div class="form-group">
                    <label for="gender">Gender:</label>
                    <select class="form-control" id="gender" name="gender" required>
                        <option value="Male" <%= user.gender === 'Male' ? 'selected' : '' %>>Male</option>
                        <option value="Female" <%= user.gender === 'Female' ? 'selected' : '' %>>Female</option>
                        <option value="Other" <%= user.gender === 'Other' ? 'selected' : '' %>>Other</option>
                    </select>
                </div>
               </div>
               
            </form>

        </div>
        <div class="  ">
            <button type="submit" class="btn btn-primary btn-block">Update Profile</button>
            <a href="<%= role === 'admin' ? '/admin-panel' : role === 'stsManager' ? '/sts-manager-panel' : '/landfill-manager-panel' %>" class="btn btn-primary btn-block">Go back</a>
        </div>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.9.5/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
