<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f3f5f2" />
  <title>STS Workspace | EcoSync</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site-header">
    <div class="site-header__inner">
      <a class="brand" href="/sts-manager-panel" aria-label="EcoSync STS workspace">
        <span class="brand__mark" aria-hidden="true">E</span>
        <span class="brand__text">
          <span class="brand__name">EcoSync</span>
          <span class="brand__descriptor">STS workspace</span>
        </span>
      </a>
      <a class="btn btn--quiet" href="/auth/logout">Sign out</a>
    </div>
  </header>

  <main class="page" id="main-content">
    <div class="page-heading">
      <p class="eyebrow">Transfer station</p>
      <h1>STS Manager workspace</h1>
      <p class="lede">Record station activity and keep your account details up to date.</p>
    </div>

    <div class="dashboard-grid">
      <section class="task-card">
        <div>
          <span class="task-card__index">Operations</span>
          <h2>New data entry</h2>
          <p>Log waste volume, timing, destination, and route distance for an STS movement.</p>
        </div>
        <a class="btn btn--primary" href="/sts-manager/data-entry">Create entry</a>
      </section>

      <section class="task-card">
        <div>
          <span class="task-card__index">Account</span>
          <h2>Profile details</h2>
          <p>Review and update your name, email, username, gender, or password.</p>
        </div>
        <a class="btn btn--secondary" href="/profile">View profile</a>
      </section>
    </div>
  </main>
</body>
</html>
